# Postgres connection string (Neon, use the pooled one). The only value the live site needs.
# Leave empty on your own computer: the app then keeps a local database in .data/
DATABASE_URL=

# Optional. Public address of the site, no trailing slash. On Netlify this is known automatically.
SITE_URL=

# Optional. Steam Web API key, used only to show Steam display names.
STEAM_API_KEY=

# Optional. OpenDota API key, only needed past the free 50,000 calls a month.
OPENDOTA_API_KEY=

# Optional. Set your own instead of the one derived from DATABASE_URL.
SESSION_SECRET=

# Testing only. "1" turns on the login-without-Steam and demo-data routes.
# Never set this on the live site.
ALLOW_DEV_LOGIN=
